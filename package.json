{
  "name": "@yafeishi/dsh-composer-history",
  "version": "0.3.0",
  "description": "Terminal-style input history for the DeepSeek Harness composer: recall previously sent messages with ArrowUp/ArrowDown when the draft is empty.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yafeishi/composer-history-dsh.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "composer",
    "input-history"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
